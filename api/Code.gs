const SPREADSHEET_ID='13TQ-pX_dWd9dgl8dcMlC9mfSNGf6euaHELXg7tDO6Ng';const SHEET_NAME='TRIP DETAILS';function doGet(){const s=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME);if(!s)return json({error:'Sheet not found'});const v=s.getDataRange().getValues();if(!v.length)return json([]);const h=v.shift().map(String);return json(v.map(r=>{let o={};h.forEach((k,i)=>o[k]=r[i] instanceof Date?r[i].toISOString():r[i]);return o}))}function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}